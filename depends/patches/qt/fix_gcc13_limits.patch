GCC 13 / libstdc++ 13 no longer transitively includes <limits>; Qt 5.9
headers that use std::numeric_limits must include it explicitly.

--- a/qtbase/src/corelib/tools/qbytearraymatcher.h
+++ b/qtbase/src/corelib/tools/qbytearraymatcher.h
@@ -42,6 +42,7 @@
 #define QBYTEARRAYMATCHER_H
 
 #include <QtCore/qbytearray.h>
+#include <limits>
 
 QT_BEGIN_NAMESPACE
